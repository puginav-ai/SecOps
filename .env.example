# Скопировать в .env и заполнить. Секреты — только в .env (права 600), не в репозитории.
# DJANGO_SECRET_KEY: случайная строка ≥ 50 символов, например: openssl rand -hex 32
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost,https://localhost:8443

POSTGRES_DB=secops
POSTGRES_USER=secops
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

SESSION_COOKIE_AGE=28800

# Временный dev-режим: реестр открыт без входа (в prod не включать, см. ADR §4 SDD)
REGISTRY_OPEN_ACCESS=0

S3_ACCESS_KEY=secops
S3_SECRET_KEY=change-me
S3_BUCKET=evidence
S3_ENDPOINT=http://s3:8333
S3_REGION=us-east-1

# Mikrotik: пассивное обнаружение через RouterOS API (Приложение В №2).
# Пусто → адаптер выключен, discovery работает только nmap. На роутере: IP → Services → api (8728),
# «Available From» — только адрес этого хоста.
MIKROTIK_HOST=
MIKROTIK_API_USER=admin
MIKROTIK_API_PASSWORD=
MIKROTIK_API_SSL=0

# SMTP (неделя 6, Приложение В №3). Пусто → письма в консоль.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=secops@localhost
